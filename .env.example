# Get your free or paid API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default: 3456)
PORT=3456

# Optional static Bearer token for Muse Custom Connector (MCP)
# Set a strong random string before exposing via cloudflared/ngrok
BRIDGE_API_KEY=

# Models (cost-optimized defaults)
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_NOTES_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
WAKE_WORD=muse
